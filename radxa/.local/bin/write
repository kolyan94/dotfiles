#!/bin/bash
# write [name] — distraction-free writing in the Obsidian vault (synced with Gitea).
# No name: today's note in Inbox/. Opens nvim in zen mode with spell check (uk, en).
V="$HOME/Documents/Obsidian/Zettel"; mkdir -p "$V/Inbox"
f="$V/Inbox/${1:-$(date +%F)}.md"
[ -f "$f" ] || printf -- '---\ncreated: %s\nsource: radxa\n---\n# %s\n\n' "$(date '+%F %H:%M')" "${1:-$(date +%F)}" > "$f"
exec nvim -c 'lua pcall(function() require("zen-mode").open() end)' -c 'setlocal spell spelllang=uk,en wrap linebreak' -c 'normal G' "$f"
